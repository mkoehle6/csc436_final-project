{
  "name": "simpsons-trivia-nerd",
  "private": true,
  "version": "0.1.0",
  "description": "TriviaNerd: a Simpsons trivia web application (final project).",
  "workspaces": [
    "frontend",
    "backend",
    "mcp-server",
    "mcp-app"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:render": "node scripts/validate-render-yaml.mjs"
  },
  "license": "UNLICENSED",
  "overrides": {
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
