# Copy to .env for local development. Never commit a real .env file.

PORT=3001
DATABASE_URL=./data/trivia.db
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OIDC (Google) — see F7/F8. OIDC_AUDIENCE is your OAuth client ID.
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=
OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Override to point at a stub server in tests/local outage simulations.
SIMPSONS_API_BASE_URL=https://thesimpsonsapi.com/api
