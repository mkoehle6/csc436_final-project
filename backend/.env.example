# Copy to .env for local development. Never commit a real .env file.
# In staging/production these come from the hosting platform's secret store.

PORT=3001
# Local dev: a directory path runs embedded PostgreSQL (PGlite) stored there.
# Staging/production: Render Postgres's postgresql://... URL (internal URL on Render;
# append ?sslmode=require if you ever connect via the external URL).
DATABASE_URL=./data/pglite
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Login (F7): Google is the identity provider -----------------------------
# From Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# The client ID is not secret; the client secret is.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# --- Access tokens (F8): issued and validated by this backend -----------------
# Where the browser returns after login.
APP_BASE_URL=http://localhost:5173
# `iss` and `aud` of our access tokens. Use the public https URL in staging/prod
# (an https issuer also turns on Secure cookies).
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=trivianerd-api
# ES256 signing key as a private JWK. Generate with: npm run auth:keygen
AUTH_PRIVATE_JWK=

# Override to point at a stub server in tests/local outage simulations.
SIMPSONS_API_BASE_URL=https://thesimpsonsapi.com/api
